{
  "id": "{modulo}",
  "nome": "{Nome do módulo}",
  "padrao": false,
  "descricao": "Copie este arquivo via: node docs/qa/scripts/qa-modulo.cjs scaffold {modulo} \"Nome visível\". Preencha telas, apis e seletores. A esteira reusa o mesmo elenco de agentes.",
  "comandosAtivacao": [
    "qa {modulo}",
    "esteira qa {modulo}",
    "qa prisma {modulo}"
  ],
  "telas": [
    {
      "id": "tela-principal",
      "nome": "Tela principal",
      "rota": "/ajuste-a-rota",
      "prefixoCenario": "X",
      "prioridade": "alta",
      "arquivos": [
        "frontend/src/epics/{modulo}/SuaPage.tsx"
      ]
    }
  ],
  "apis": [
    "frontend/src/api/seuCliente.ts"
  ],
  "dominio": [],
  "dataforge": {
    "estrategia": "constantes-js-alinhadas-api",
    "descricao": "Massa como constantes JS mapeadas ao contrato da API/UI. Sem SQL fictício no E2E live.",
    "apisPrincipais": [
      "frontend/src/api/seuCliente.ts"
    ],
    "formulario": "frontend/src/epics/{modulo}/SuaPage.tsx"
  },
  "outputs": {
    "bdd": {
      "dir": "docs/qa/outputs/gherkinflow/{modulo}",
      "arquivo": "{MODULO}-BDD-v{N}.md"
    },
    "data": {
      "dir": "docs/qa/outputs/dataforge/{modulo}",
      "arquivo": "{modulo}.data.v{N}.js"
    },
    "spec": {
      "dir": "docs/qa/outputs/playwright/{modulo}/specs",
      "arquivo": "{modulo}-qa-v{N}.spec.ts"
    },
    "relatorio": {
      "dir": "docs/qa/outputs/playwright/{modulo}/relatorios",
      "arquivo": "qa-{modulo}-v{N}.html"
    }
  },
  "inputs": {
    "uiJson": "docs/qa/inputs/ui-elements/{modulo}-ui.json"
  },
  "playwright": {
    "baseUrl": "http://localhost:5173",
    "headed": true,
    "slowMo": 150,
    "executarTodos": true,
    "cenarioSelfHealingExemplo": "X-01"
  },
  "selfHealing": {
    "habilitado": true,
    "humanInTheLoop": true,
    "maxTentativas": 2,
    "protocolo": "docs/qa/agentes/self-healing/protocolo.md",
    "skill": "docs/qa/agentes/self-healing/self-healing.md",
    "agenteDev": {
      "id": "dev-kernel",
      "bridge": "docs/qa/agentes/dev-kernel/bridge.md"
    },
    "auditLog": "docs/qa/setup/self-healing-audit.jsonl",
    "falhaPendente": "docs/qa/setup/.qa-falha-pendente.json",
    "script": "docs/qa/scripts/qa-self-healing.cjs"
  },
  "ambiente": {
    "nome": "lab",
    "frontLocal": "http://localhost:5173",
    "backend": "http://localhost:8080",
    "python": "http://localhost:8090",
    "nota": "Browser nunca chama :8090 — GenAI via BFF Java."
  },
  "versionamento": {
    "maxVersoes": 99,
    "bddPattern": "^{MODULO}-BDD-v(\\d+)\\.md$",
    "dataPattern": "^{modulo}\\.data\\.v(\\d+)\\.js$",
    "specPattern": "^{modulo}-qa-v(\\d+)\\.spec\\.ts$"
  }
}
