# mock = Vitest / fixtures | live = Noah :8080 (único backend público)
VITE_DATA_MODE=live

# Empty = same-origin + Vite/Nginx proxy → backend
VITE_API_BASE_URL=

# --- OIDC (form Prisma → Keycloak password grant · client prisma-lab) ---
# live ⇒ login obrigatório por default.
# VITE_OIDC_ENABLED=true
# Issuer do JWT (Spring valida). Browser usa proxy /realms/prisma.
VITE_OIDC_ISSUER=http://localhost:8180/realms/prisma
# Vazio = ${origin}/realms/prisma (Nginx/Vite proxy)
# VITE_OIDC_BROWSER_BASE=
VITE_OIDC_PASSWORD_CLIENT_ID=prisma-lab
# SSO opcional (redirect Keycloak + PKCE)
VITE_OIDC_CLIENT_ID=prisma-steward-ui

# Atalho lab (opcional): Bearer estático — preferir /login.
# VITE_API_BEARER=

# EP-03 Copiloto PJ (lab)
# VITE_PJ_OPINION_ID=
# VITE_PJ_CNPJ=
# VITE_PJ_DOC_ID=
