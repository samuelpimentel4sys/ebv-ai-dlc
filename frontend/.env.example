# mock = Vitest / fixtures | live = Noah :8080 + Emilly :8090 (proxy Vite)
VITE_DATA_MODE=live

# Empty = same-origin + Vite proxy
# HITL /api/v1/pj/opinions/*/submit|approve|trail → :8080 (Noah)
# /api/v1/pj/** (GenAI) → :8090 (Emilly)
# demais /api → :8080
VITE_API_BASE_URL=

# Opcional: GenAI direto (sem proxy). Vazio = same-origin.
# VITE_GENAI_BASE_URL=

# Lab aberto (OIDC_ENABLED=false no BE): deixe vazio — httpClient chama sem auth.
# Demo JWT (OIDC on): cole access_token do Keycloak lab (não é login de produto).
# Produto: client prisma-steward-ui + PKCE (sprint P6) — não use client_secret no browser.
# Keycloak lab: http://192.168.31.47:8180/realms/prisma
# VITE_API_BEARER=

# EP-03 Copiloto PJ (lab)
# UUID parecer (HITL Noah + GenAI Emilly). Sem isso, FE cria/lembra via sessionStorage.
# VITE_PJ_OPINION_ID=
# CNPJ lab (default Aurora 12345678000190)
# VITE_PJ_CNPJ=
# UUID documento extração (GET .../documents/{id}/extraction)
# VITE_PJ_DOC_ID=
