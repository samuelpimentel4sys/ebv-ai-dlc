SPRING_DATASOURCE_PASSWORD=REPLACE_WITH_SUPABASE_DB_PASSWORD

# Forçados pelo profile showcase (podem omitir):
# GRAPH_BACKEND=stub
# ONNX_MODE=stub
# LIVENESS_MODE=stub
