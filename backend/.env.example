# Copiar para .env (não versionar)
SPRING_PROFILES_ACTIVE=supabase
SPRING_DATASOURCE_URL=jdbc:postgresql://db.jrpjrvttiqustpfedxdz.supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=REPLACE_WITH_SUPABASE_DB_PASSWORD

# Showcase (só Supabase — sem Redis/Kafka/Neo4j/Python):
# PRISMA_SHOWCASE=true
# SPRING_PROFILES_ACTIVE=supabase
# Ver docs/MODO_SHOWCASE.md e .env.showcase.example

# --- Quando Redis/Kafka/Keycloak estiverem prontos, acrescente e use:
# SPRING_PROFILES_ACTIVE=supabase,infra
# Ver docs/PROVISIONAMENTO_REDIS_KAFKA_KEYCLOAK.md

# REDIS_HOST=
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_SSL=false

# KAFKA_BOOTSTRAP=
# KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# KAFKA_TOPIC_CREDIT=prisma.credit.events
# KAFKA_TOPIC_CREDIT_DLQ=prisma.credit.events.dlq
# KAFKA_TOPIC_IDENTITY=prisma.identity.corrections

# OIDC (Sprint 6 smoke — ver docs/SPRINT6_HARDENING.md)
# OIDC_ISSUER_URI=http://192.168.31.47:8180/realms/prisma
# OIDC_CLIENT_ID=prisma-backend
# OIDC_CLIENT_SECRET=
# OIDC_ENABLED=false
# prisma.security.enabled mirrors OIDC_ENABLED when profile=infra

# WORM backend: fs (lab default) | s3 (Object Lock COMPLIANCE)
# PRISMA_WORM_BACKEND=fs
# PRISMA_AUDIT_WORM_BACKEND=fs
# PRISMA_WORM_S3_BUCKET=prisma-worm-prod
# PRISMA_WORM_S3_REGION=ca-central-1
# PRISMA_WORM_S3_PREFIX=decisions/
# PRISMA_WORM_S3_RETENTION_YEARS=5
# AWS credentials: default chain (env / profile / IAM role)

# Neo4j (lab substitute for Neptune) · ONNX sidecar · Fairlearn
# GRAPH_BACKEND=stub|neo4j
# NEO4J_URI=bolt://192.168.31.47:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=
# ONNX_MODE=stub|http
# ONNX_SCORER_URL=http://192.168.31.47:8091
# ONNX_MODEL_PATH=/opt/prisma/models/score-v1.onnx
# FAIRLEARN_ENABLED=false
# FAIRLEARN_URL=http://192.168.31.47:8092
