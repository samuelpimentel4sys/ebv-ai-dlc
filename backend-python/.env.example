# PRISMA-EP-03 Copiloto GenAI PJ — multi-provider (sem voz)
INFERENCE_PROVIDER=local

# Supabase Prisma Equifax (mesmo DB do backend Java)
DATABASE_URL=postgresql+asyncpg://postgres:REPLACE_PASSWORD@db.jrpjrvttiqustpfedxdz.supabase.co:5432/postgres
DATABASE_SSL=require
DATABASE_SSL_INSECURE=true

# RAG / pgvector
RAG_VECTOR_DIMS=1536
RAG_INDEX_VERSION=v1-local-nomic-768pad

# local (Ollama OpenAI-compat) — mesmo padrão Jarvis
LOCAL_LLM_BASE_URL=http://192.168.31.47:11434/v1
LOCAL_LLM_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_EMBED_DIMS=768

# openai (análise / eval)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_EMBED_DIMS=1536

# gemini (análise / eval)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=text-embedding-004
GEMINI_EMBED_DIMS=768

# bedrock (prod EBV)
AWS_REGION=us-east-1
BEDROCK_CHAT_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_EMBED_DIMS=1024

REDIS_URL=redis://localhost:6380/0
ENVIRONMENT=local

# F08 grupo (stub Neptune)
GROUP_GRAPH_BACKEND=stub
GROUP_MAX_NODES=50
GROUP_STALE_DAYS=7

# OIDC / Keycloak — espelho Noah (lab default off)
OIDC_ENABLED=false
OIDC_ISSUER_URI=http://192.168.31.47:8180/realms/prisma
OIDC_JWK_SET_URI=http://192.168.31.47:8180/realms/prisma/protocol/openid-connect/certs
# OIDC_AUDIENCE=prisma-backend
OIDC_CLIENT_ID=prisma-backend
