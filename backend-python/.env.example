# PRISMA-EP-03 Copiloto GenAI PJ — multi-provider (sem voz)
INFERENCE_PROVIDER=local

# Showcase: só Supabase real — LLM/embed/OIDC/Neptune simulados (demo/pitch)
# SHOWCASE_MODE=true  → força inference=stub, OIDC=false, index v1-showcase-stub
SHOWCASE_MODE=false

# Postgres local do compose Prisma (mesmo DB do backend Java)
# No container genai o host vira "postgres" via override do docker-compose
DATABASE_URL=postgresql+asyncpg://prisma:prisma@localhost:5432/prisma
DATABASE_SSL=
DATABASE_SSL_INSECURE=false

# RAG / pgvector
RAG_VECTOR_DIMS=1536
RAG_INDEX_VERSION=v1-local-nomic-768pad

# local (Ollama OpenAI-compat) — mesmo padrão Jarvis (ignorado se SHOWCASE_MODE=true)
LOCAL_LLM_BASE_URL=http://192.168.31.47:11434/v1
LOCAL_LLM_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_EMBED_DIMS=768

# openai (análise / eval)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_EMBED_DIMS=1536

# gemini (análise / eval)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=text-embedding-004
GEMINI_EMBED_DIMS=768

# bedrock (prod EBV)
AWS_REGION=us-east-1
BEDROCK_CHAT_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_EMBED_DIMS=1024

# Redis (compose exige REDIS_PASSWORD; URL local com auth)
REDIS_PASSWORD=change-me-redis
REDIS_URL=redis://:change-me-redis@localhost:6380/0
ENVIRONMENT=local

# F08 grupo (stub Neptune)
GROUP_GRAPH_BACKEND=stub
GROUP_MAX_NODES=50
GROUP_STALE_DAYS=7

# OIDC / Keycloak — default seguro ON + audience (verify_aud)
# Lab sem Keycloak: ENVIRONMENT=local + OIDC_ENABLED=false (lab bypass)
# SHOWCASE_MODE=true também força OIDC off (só válido com ENVIRONMENT=local)
OIDC_ENABLED=true
OIDC_ISSUER_URI=http://192.168.31.47:8180/realms/prisma
OIDC_JWK_SET_URI=http://192.168.31.47:8180/realms/prisma/protocol/openid-connect/certs
OIDC_AUDIENCE=prisma-backend
OIDC_CLIENT_ID=prisma-backend
